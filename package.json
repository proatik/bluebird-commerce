{
  "name": "bluebird-commerce",
  "version": "0.1.0",
  "description": "Minimal e-commerce backend with a chat assistant, for the BluBird Interactive assessment",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "setup": "docker compose up -d db && tsx scripts/wait-for-db.ts && npm run db:migrate && npm run seed",
    "start:clean": "npm run setup && npm run start:dev"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@scalar/nestjs-api-reference": "^1.2.22",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.0",
    "nestjs-zod": "^5.0.0",
    "openai": "^7.23.0",
    "openapi3-ts": "^4.6.1",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.0"
  },
  "overrides": {
    "nestjs-zod": {
      "@nestjs/common": "$@nestjs/common"
    }
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
